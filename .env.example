# Salin ke .env lalu isi. Jangan pakai tanda $ atau kutip di nilai password.

# --- MySQL ---
MYSQL_ROOT_PASSWORD=ganti_root_password
MYSQL_DATABASE=macro
MYSQL_USER=macro
MYSQL_PASSWORD=ganti_password
MYSQL_HOST=mysql
MYSQL_PORT=3306

# --- Data (gratis) ---
# FRED: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
# EIA : https://www.eia.gov/opendata/register.php
EIA_API_KEY=

# --- LLM (opsional; tanpa key, klasifikasi berita dilewati) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
LLM_MAX_PER_RUN=40

# --- Telegram (opsional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- API internal (dipakai Laravel lewat header X-API-Key) ---
API_KEY=ganti_dengan_string_acak_panjang

TZ=Asia/Jakarta
